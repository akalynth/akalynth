# Akalynth Asset Factory — generation config. Copy to tools/asset-gen/.env (NEVER commit).
# tools/asset-gen/.env is gitignored.

# Required to generate raw assets (OpenAI image API). Without it, generate.ts
# makes no network call and exits.
OPENAI_API_KEY=

# Optional: image model (default gpt-image-1).
# OPENAI_IMAGE_MODEL=gpt-image-1
