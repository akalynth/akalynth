{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "./scripts/refuse_windows.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "command": "./scripts/format_ts.sh"
      },
      {
        "matcher": "Write",
        "command": "./scripts/format_ts.sh"
      }
    ]
  }
}
