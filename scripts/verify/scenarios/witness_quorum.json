{
  "name": "witness_quorum",
  "auto_tem": true,
  "duration_ms": 18000,
  "events": [],
  "expect": [
    { "type": "tem_witness_request" }
  ],
  "hooks": [
    {
      "when": { "type": "tem_witness_request" },
      "send": {
        "type": "tem_witness_response",
        "request_id": "$REQUEST_ID",
        "response": "confirm"
      },
      "delay_ms": 500
    }
  ]
}
