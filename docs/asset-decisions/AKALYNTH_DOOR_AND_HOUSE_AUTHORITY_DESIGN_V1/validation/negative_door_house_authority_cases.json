        "visual_object_forbidden_field:door_state"
      ],
      "payload": {
        "plane": "visual",
        "asset_id": "door_wood_closed_south",
        "door_state": "open"
      }
    },
    {
      "id": "negative_roof_overlay_declares_house_ownership",
