        "access_policy_cannot_be_implied_by_lock_state"
      ],
      "payload": {
        "plane": "door_authority",
        "lock_state": "locked",
        "access_policy": "owner_only"
      }
    },
    {
      "id": "negative_overlay_visibility_uses_debug_fixture_as_runtime_source",
