      ],
      "payload": {
        "plane": "presentation_overlay",
        "asset_id": "roof_red_small_overlay_01",
        "ownership": "player_owned"
      }
    },
    {
      "id": "negative_collision_candidate_resolves_door_passability",
      "expected_flags": [
        "door_authority_required_for_threshold_resolution"
      ],
      "payload": {
        "plane": "collision",
        "tile": [
          8,
          24
        ],
        "collision_state": "clear",
        "category": "building_door_threshold"
      }
    },
    {
      "id": "negative_walkability_candidate_resolves_door_passability",
      "expected_flags": [
        "door_authority_required_for_threshold_resolution"
      ],
      "payload": {
        "plane": "walkability",
        "tile": [
          8,
          24
        ],
        "walkability_state": "walkable",
        "category": "building_door_threshold"
      }
    },
    {
      "id": "negative_house_region_derived_from_roof_overlay",
      "expected_flags": [
