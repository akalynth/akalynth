{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akalynth.draft.transition_policy.schema.v1",
  "title": "Draft Transition Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation",
    "directionality",
    "safety",
    "authority_status"
  ],
  "properties": {
    "activation": {
      "enum": [
        "step_on",
        "use_action",
        "scripted_event",
        "reserved_unknown"
      ]
    },
    "directionality": {
      "enum": [
        "one_way",
        "two_way",
        "gated_by_state",
        "gated_by_permission",
        "reserved_unknown"
      ]
    },
    "safety": {
      "type": "array",
      "items": {
        "enum": [
          "destination_must_exist",
          "destination_must_be_walkable",
          "destination_must_not_spawn_inside_blocker",
          "destination_must_preserve_lockstep_authority",
          "destination_may_require_receipt"
        ]
      }
    },
    "authority_status": {
      "const": "future_gate_required"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
