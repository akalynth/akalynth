{
  "name": "@akalynth/coordination-kernel",
  "version": "0.1.0",
  "type": "module",
  "description": "Domain-agnostic coordination primitives extracted from Akalynth",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nonconstitutional": {
      "types": "./dist/nonconstitutional.d.ts",
      "default": "./dist/nonconstitutional.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "tsc --watch"
  },
  "keywords": [
    "coordination",
    "receipts",
    "capabilities",
    "compliance",
    "audit",
    "post-bureaucratic"
  ],
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "fast-json-stable-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "examples/**/*"
  ],
  "engines": {
    "node": ">=18"
  }
}
