# Dependencies
**/node_modules/

# Build output
**/dist/
server/dist/
**/build/
**/.vite/

# Logs
*.log

# Local temp
tmp/
.tmp/
**/.tmp/

# Generated reports / exports
artifacts/

# Audit receipts (local dev only)
apps/server/audit/

# Persistence data (SQLite, replay markers)
apps/server/data/

# Draft/proposal folders
__*/

# OS files
.DS_Store

# Rust build artifacts
**/target/

# Chronicle local files (dev only)
chronicle.log
chronicle.key
.secrets/

# Rulebook compiled outputs (generated, except .gitkeep)
rulebook/compiled/operator.key
rulebook/compiled/RULEBOOK.manifest.json
rulebook/compiled/RULEBOOK_ROOT.txt
rulebook/compiled/GENESIS.json
rulebook/compiled/GENESIS.sig

# Spine Lock forbidden legacy roots
/server/
/client/
# Core dumps / crash artifacts
apps/server/core.*

# Local IDE/agent state
.continue/
.agents/skills/
packages/shared/*.js
tools/*.js
apps/server/.tmp_chain.*/
!tools/doc_audit.js

# TypeScript incremental build info
**/*.tsbuildinfo

# Generated receipt chains (fixtures are produced by tools, not tracked)
apps/server/fixtures/**/receipts.jsonl

# Generated CI/CD change-control outputs (never track)
packages/ci-cd-change-control/**/receipts*.jsonl
packages/ci-cd-change-control/**/test-receipts*.jsonl
packages/ci-cd-change-control/**/final-test*.jsonl
packages/ci-cd-change-control/**/pass-test*.jsonl
packages/ci-cd-change-control/**/final-test-receipts/
packages/ci-cd-change-control/**/test-receipts/
verify-out/

# Secrets — never track local env files (e.g. tools/asset-gen/.env holds an API key)
**/.env
.cf.env

# asset-gen Python tooling and raw AI source dumps (local only, regenerable)
tools/asset-gen/.venv/
tools/asset-gen/**/_raw/

# Raw high-res AI source dumps under assets-src (regenerable; processed 32px sprites are tracked)
data/assets-src/**/_raw/

# Compiled JS build artifacts of tracked .ts sources (regenerate via tsc/tsx)
packages/shared/scripts/*.js
packages/verification-spine/src/**/*.js

# Map-compiler generated output (compilers emit here; runtime consumes built maps).
# Editors write data/world/maps-src/; built maps + .mapgen.json manifest + .svg
# are reproducible from `generate` (same params -> identical map_hash/svg_hash),
# so they are not committed (prevents accidental promotion of generated samples).
data/world/maps-built/
