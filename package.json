{
  "name": "akalynth",
  "version": "0.1.0",
  "description": "A social-first, low-grind MMO prototype",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && cd apps/server && npm install && cd ../debug-client && npm install",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs",
    "dev:server": "cd apps/server && npm run dev",
    "dev:server:fresh": "node scripts/dev-bootstrap.mjs && cd apps/server && AKALYNTH_BOOTSTRAP=1 CHRONICLE_KEY_PATH=chronicle.key ALLOW_INSECURE_LOCAL=1 npm run dev",
    "dev:client": "cd apps/debug-client && npm run dev",
    "build:server": "cd apps/server && npm run build",
    "build:client": "cd apps/debug-client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "build:packages": "npm -w @akalynth/coordination-kernel run build && npm -w @akalynth/learning-spine run build && npm -w @akalynth/verification-spine run build",
    "studio-smoke": "node scripts/studio-smoke.mjs",
    "build:game": "(cd apps/phone-server && npm run build) && (cd apps/studio && npm run build) && (cd apps/debug-client && npm run build) && npm run studio-smoke",
    "build:assets:rookguard": "node tools/asset-gen/build-rookguard-tutorial-tiles.mjs && node tools/asset-gen/build-rookguard-canal-visuals.mjs",
    "verify": "npm run build:packages && node packages/verification-spine/bin/akalynth-verify.js",
    "verify:quick": "npm run build:packages && node packages/verification-spine/bin/akalynth-verify.js --profile quick --skip-build",
    "verify:full": "npm run build:packages && node packages/verification-spine/bin/akalynth-verify.js --profile full",
    "verify:audit": "npm run build:packages && node packages/verification-spine/bin/akalynth-verify.js --profile audit",
    "verify:account-character": "bash scripts/verify_protocol_sync.sh && npm -w apps/server run verify:quick && npm -w apps/server run test:web-economy && npm -w apps/debug-client run verify:account-character && cd apps/android && ./gradlew :app:compileDebugAndroidTestKotlin testDebugUnitTest --tests 'com.akalynth.client.network.IdentityApiAccountCharacterTest' --tests 'com.akalynth.client.network.AkalynthClientAccountTokenLoginTest' --tests 'com.akalynth.client.config.BuildConfigPortalTest' --tests 'com.akalynth.client.protocol.ProtocolParityTest'",
    "verify:beta-account-play-portal": "node scripts/verify-beta-account-play-portal.mjs",
    "verify:play-motion": "node scripts/verify-play-motion-contract.mjs",
    "smoke:beta-account-play": "node scripts/smoke-beta-account-play.mjs --live",
    "smoke:beta-account-play:api": "node scripts/smoke-beta-account-play.mjs --live --no-browser",
    "smoke:beta-account-play:real": "node scripts/smoke-beta-account-play.mjs --live --real-account",
    "smoke:web-play-shell": "node scripts/smoke-web-play-shell.mjs",
    "verify:showcase": "bash scripts/showcase_local.sh",
    "verify:docker-runtime": "bash scripts/verify-docker-runtime.sh",
    "smoke:docker-runtime": "bash scripts/smoke-docker-runtime.sh",
    "render:docker-runtime": "bash scripts/render-docker-runtime.sh",
    "validate:codex-plugin": "node tools/validate-codex-plugin.mjs",
    "verify:skills": "bash scripts/verify_skills.sh",
    "verify:lifecycle": "npm -w apps/server run verify:lifecycle",
    "verify:receipt-hygiene": "npm -w apps/server run verify:receipt-hygiene",
    "verify:outcome": "tsx tools/verify-outcome/src/index.ts",
    "verify:outcome:test": "tsx tools/verify-outcome/test.ts",
    "verify:assets": "tsx tools/asset-gen/verify-assets.ts",
    "build:atlas": "node tools/atlas/build-atlas.mjs",
    "bench:atlas-decode": "node tools/atlas/bench-decode.mjs",
    "build:assets": "node tools/atlas/compile-registry.mjs && node tools/atlas/sync-to-clients.mjs --use-compiled-registry && node tools/atlas/build-atlas.mjs",
    "build:assets:loose": "node tools/atlas/sync-to-clients.mjs",
    "sync:assets": "node tools/atlas/sync-to-clients.mjs",
    "verify:asset-sync": "node tools/atlas/verify-sync.mjs",
    "validate:placement": "node tools/atlas/validate-placement.mjs",
    "port:rookguard-placements": "node tools/atlas/port-rookguard-placements.mjs",
    "port:deferred-placements": "node tools/atlas/port-deferred-placements.mjs",
    "verify:web-visual-assets": "node scripts/verify-web-visual-assets.mjs",
    "verify:web-rust-cleanup": "node scripts/verify-web-rust-cleanup.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "sharp": "^0.33.5"
  },
  "keywords": [
    "mmo",
    "game",
    "akalynth",
    "multiplayer"
  ],
  "author": "",
  "license": "ISC"
}
