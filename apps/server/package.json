{
  "name": "akalynth-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ../../scripts/refuse_windows.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node ../../dist/server/apps/server/src/index.js",
    "verify": "tsx tools/verify-guarantees.ts",
    "verify:verbose": "tsx tools/verify-guarantees.ts --verbose",
    "verify:quick": "tsx tools/verify-guarantees.ts --skip-build",
    "verify:heat": "tsx tools/verify-heat.ts",
    "verify:protected": "tsx tools/verify-protected.ts",
    "verify:anticheat-persistence": "tsx tools/verify-anticheat-persistence.ts",
    "verify:npc-dialogue": "tsx tools/verify-npc-dialogue-counter.ts",
    "verify:npc-recognition": "tsx tools/verify-npc-recognition.ts",
    "verify:presence": "tsx tools/verify-presence.ts",
    "verify:costed-actions": "tsx tools/verify-costed-actions.ts",
    "verify:lifecycle": "tsx tools/verify-lifecycle.ts",
    "verify:chronicle": "tsx tools/verify-chronicle.ts",
    "verify:chronicle-chain": "tsx tools/verify-chronicle-chain.ts",
    "verify:receipts-chain": "tsx tools/verify-receipts-chain.ts",
    "test:receipts-chain": "tsx tools/test-receipts-chain.ts",
    "verify:receipt-hygiene": "node ../../scripts/require-chronicle.js && npm run verify:lifecycle && npm run verify:chronicle-chain && bash ../../scripts/test-chain-discipline.sh",
    "verify:rate-limits": "tsx tools/verify-rate-limits.ts",
    "verify:evidence": "tsx tools/verify-evidence.ts",
    "verify:identity": "tsx tools/verify-identity.ts",
    "verify:transparency": "tsx tools/verify-transparency.ts",
    "verify:doctrine": "tsx tools/verify-doctrine.ts",
    "verify:monetization": "tsx tools/verify-monetization.ts",
    "verify:treasury": "tsx tools/verify-treasury.ts",
    "verify:work-contracts": "tsx tools/verify-work-contracts.ts",
    "verify:property": "tsx tools/verify-property.ts",
    "verify:property-auction": "tsx tools/verify-property-auction.ts",
    "verify:property-auction-wallet-escrow": "tsx tools/verify-property-auction-wallet-escrow.ts",
    "verify:ops": "tsx tools/verify-ops.ts",
    "fixture:generate": "tsx tools/generate-ci-fixture.ts",
    "materialize-db": "tsx tools/materialize-db.ts",
    "export:monetization-redacted": "tsx tools/export-monetization-redacted.ts",
    "chronicle:demo": "tsx tools/chronicle-demo.ts",
    "chronicle:adapter:smoke": "tsx tools/chronicle-adapter-smoke.ts",
    "rulebook:genesis": "tsx tools/genesis-rulebook.ts",
    "install-hooks": "bash scripts/install-hooks.sh",
    "verify:mob-loot": "tsx tools/verify-mob-loot.ts",
    "verify:item-pickup-type": "tsx tools/verify-item-pickup-type.ts",
    "verify:property-auction-handlers": "tsx tools/verify-property-auction-handlers.ts"
  },
  "dependencies": {
    "@akalynth/coordination-kernel": "file:../../packages/coordination-kernel",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^1.3.3",
    "better-sqlite3": "^11.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "wscat": "^5.2.0"
