{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "types": ["vite/client", "node"],
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/*"],
      "@codex/*": ["../../../akalynth-codex/*", "codex-fallback/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
