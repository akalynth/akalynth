{
  "name": "akalynth-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/verify-account-character-guard.mjs && node scripts/verify-gather-wire-authority.mjs && node scripts/verify-nine-slice-panel.mjs && node scripts/verify-character-create-preview.mjs && node scripts/verify-death-chronicle-glyphs.mjs && node scripts/verify-builder-panel-v1.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "verify:account-character": "node scripts/verify-account-character-guard.mjs && node scripts/verify-debug-gameplay-wire-authority.mjs && node scripts/verify-gather-wire-authority.mjs",
    "verify:gather-client": "node scripts/verify-gather-wire-authority.mjs",
    "verify:character-create-preview": "node scripts/verify-character-create-preview.mjs",
    "verify:death-chronicle-glyphs": "node scripts/verify-death-chronicle-glyphs.mjs",
    "verify:nine-slice-panel": "node scripts/verify-nine-slice-panel.mjs",
    "verify:builder-panel-v1": "node scripts/verify-builder-panel-v1.mjs",
    "verify:builder-preview-render-v1": "node scripts/verify-builder-preview-render-v1.mjs",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json",
    "smoke:mobile": "node scripts/mobile-playable-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.11"
  }
}
