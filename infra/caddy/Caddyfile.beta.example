# Akalynth reverse proxy — DEV box (ops-dev-01, 194.147.221.89)
#
# Provides a named public entry point for the development / staging game server.
# Both names proxy to the same loopback port so the browser and API clients
# use the same TLS-terminating host.
#
# DNS prerequisites (Cloudflare, before caddy reload):
#   A  beta.akalynth.com      →  194.147.221.89
#   A  beta-api.akalynth.com  →  194.147.221.89
# Cloudflare proxy mode: Full (strict) — chain is CF → Caddy → Node.
#
# Firewall: 80 and 443 must be open on this host before Caddy can issue TLS.
#   sudo ufw allow 80/tcp comment 'Caddy ACME'
#   sudo ufw allow 443/tcp comment 'Caddy TLS'
#   sudo ufw allow 443/udp comment 'Caddy QUIC/HTTP3'
#
# Install Caddy on ops-dev-01 if not present:
#   https://caddyserver.com/docs/install#debian-ubuntu-raspbian
#
# Copy this file:
#   sudo cp infra/caddy/Caddyfile.beta.example /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Health check:
#   curl -sf https://beta-api.akalynth.com/v1/health | grep '"ok":true'
#
# Use with deploy_dev.sh:
#   AKALYNTH_HEALTH_URL is pre-set to https://beta-api.akalynth.com/v1/health

# ── Dev / staging game server ─────────────────────────────────────────────────
beta.akalynth.com, beta-api.akalynth.com {
	encode zstd gzip

	# Loopback bind owned by the dev game server process.
	# Start the server with: cd ~/dev/akalynth && npm run dev:server:fresh
	# (or use the pm2 / systemd unit if one is configured on this box)
	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/akalynth-beta.log
		format json
	}
}
