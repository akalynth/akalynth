# Akalynth reverse proxy (PROD box)
#
# Caddy terminates TLS and proxies to the Node server bound on loopback.
# The game server itself NEVER binds a public interface (HOST=127.0.0.1 in
# infra/systemd/akalynth.service). Copy this to /etc/caddy/Caddyfile and
# reload with: sudo systemctl reload caddy
#
# DNS: api.akalynth.com must resolve to this host before TLS issuance works.
# If Cloudflare proxy (orange-cloud) is in front, keep it in "Full (strict)"
# mode so the chain is Cloudflare -> Caddy -> Node (matches deploy_beta.sh).

api.akalynth.com {
	encode zstd gzip

	# Loopback bind owned by akalynth.service
	reverse_proxy 127.0.0.1:3000

	# Health endpoint stays public for uptime probes
	# (GET /v1/health and /v1/transparency are public by design)

	log {
		output file /var/log/caddy/akalynth.log
		format json
	}
}
