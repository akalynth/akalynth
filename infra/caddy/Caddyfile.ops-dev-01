# Akalynth beta + staging lanes - ops-dev-01 (194.147.221.89)
#
# Mobile lane model: the SITE hosts (beta./staging./sim.) serve static files
# only. Beta may serve the public marketing/download payload plus APK artifacts.
# Staging is APK-only unless explicitly mirrored. Sim is an operational dashboard
# for the isolated simulation lane. The game runtime is reached directly through
# the *-api hosts (HTTP API + WebSocket), never through the site host.
#
# This file is the versioned source of truth for /etc/caddy/Caddyfile on this box.

# --- Beta site: static marketing/download payload plus APK artifacts ---
beta.akalynth.com {
	encode zstd gzip
	root * /var/www/akalynth-beta
	file_server
	log {
		output file /var/log/caddy/akalynth-beta.log
		format json
	}
}

# --- Beta API + WebSocket (Android beta build connects here) ---
beta-api.akalynth.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/akalynth-beta-api.log
		format json
	}
}

# --- Staging site: APK download page only ---
staging.akalynth.com {
	encode zstd gzip
	root * /var/www/akalynth-staging
	file_server
	log {
		output file /var/log/caddy/akalynth-staging.log
		format json
	}
}

# --- Staging API + WebSocket (Android staging build connects here) ---
staging-api.akalynth.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
	log {
		output file /var/log/caddy/akalynth-staging-api.log
		format json
	}
}

# --- Simulation dashboard: static operational status only ---
sim.akalynth.com {
	encode zstd gzip
	root * /var/www/akalynth-sim
	file_server
	log {
		output file /var/log/caddy/akalynth-sim.log
		format json
	}
}

# --- Simulation API + WebSocket (isolated state/receipt lane) ---
sim-api.akalynth.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002
	log {
		output file /var/log/caddy/akalynth-sim-api.log
		format json
	}
}
