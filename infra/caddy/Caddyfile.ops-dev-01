# witnessops-web k8s staging — opaque host (ops-dev-01); uses hostport 3000
43467cca9728cf58.witnessops.com {
	encode zstd gzip
	@gated path /review/request /api/review/request /api/verify-token
	handle @gated {
		respond "Service temporarily unavailable" 503
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	log {
		output file /var/log/caddy/witnessops-staging-web.log
		format json
	}
}