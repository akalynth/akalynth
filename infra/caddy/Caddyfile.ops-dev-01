# Akalynth preview lanes — ops-dev-01 (194.147.221.89) / K8s preview node
# Lanes: beta, staging, sim. Production (api.akalynth.com) is NOT routed here.
#
# Beta game server listens on 127.0.0.1:3010 (systemd drop-in 70-port-avoid-k8s.conf).
# Port 3000 is hostport-DNAT to witnessops-web k8s — do not point Akalynth beta at 3000.
#
# This file is the versioned source of truth for /etc/caddy/Caddyfile on this box.

# --- Beta site: static payload + same-origin game API/WebSocket + /play client ---
beta.akalynth.com {
	encode zstd gzip
	root * /var/www/akalynth-beta

	@api path /v1/*
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @api {
		reverse_proxy 127.0.0.1:3010
	}
	handle @ws {
		reverse_proxy 127.0.0.1:3010
	}

	handle /operator/login* {
		file_server
	}

	@operator path /operator /operator/*
	@builder path /builder /builder/*
	@agent path /agent /agent/*
	handle @operator {
		forward_auth 127.0.0.1:3010 {
			uri /v1/accounts/authorize?surface=operator
		}
		file_server
	}
	handle @builder {
		forward_auth 127.0.0.1:3010 {
			uri /v1/accounts/authorize?surface=builder
		}
		file_server
	}
	handle @agent {
		forward_auth 127.0.0.1:3010 {
			uri /v1/accounts/authorize?surface=agent
		}
		file_server
	}

	handle /play/* {
		try_files {path} /play/index.html
		file_server
	}

	handle {
		file_server
	}

	log {
		output file /var/log/caddy/akalynth-beta.log
		format json
	}
}

# --- Beta API + WebSocket (Android beta build connects here) ---
beta-api.akalynth.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3010
	log {
		output file /var/log/caddy/akalynth-beta-api.log
		format json
	}
}

