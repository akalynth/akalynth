# Placeholder-only example. Do not put real values in Git.

# Host-side Compose interpolation can use this path when passed as --env-file
# or exported in the shell before docker compose runs.
AKALYNTH_CHRONICLE_KEY_FILE=/etc/akalynth/chronicle.key

# First boot on an intentionally fresh runtime volume may set this to 1.
# Keep it at 0 for normal restarts so missing history fails closed.
AKALYNTH_BOOTSTRAP=0

# Leave lifecycle verification enabled for production parity with systemd.
AKALYNTH_LIFECYCLE_VERIFY=1

# Public receipt defaults mirror the server code. Override only with an
# explicit operations decision.
PUBLIC_RECEIPTS_DELAY_MS=900000
PUBLIC_RECEIPTS_BUCKET_SIZE=8
PUBLIC_RECEIPTS_JITTER_MS=120000
