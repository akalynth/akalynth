[Unit]
Description=Akalynth Server (beta)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=akalynth
Group=akalynth
WorkingDirectory=/opt/akalynth/apps/server
Environment=HOME=/var/lib/akalynth
UMask=0077

# Runtime paths (NO repo writes)
Environment=AKALYNTH_RECEIPT_CHAIN_PATH=/var/lib/akalynth/audit/receipts.jsonl
Environment=AKALYNTH_DB_PATH=/var/lib/akalynth/data/akalynth.db
Environment=AKALYNTH_REPLAY_MARKER_PATH=/var/lib/akalynth/data/replay_marker.json
Environment=CHRONICLE_KEY_PATH=/etc/akalynth/chronicle.key

# Server mode
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=REQUIRE_TLS=1
Environment=TRUST_PROXY=1
Environment=TRUST_PROXY_LOOPBACK_ONLY=1
Environment=ALLOW_INSECURE_LOCAL=0
Environment=NODE_ENV=production

# systemd-managed dirs (creates /var/lib/akalynth with correct owner)
StateDirectory=akalynth
StateDirectoryMode=0750
RuntimeDirectory=akalynth
RuntimeDirectoryMode=0750

# Preflight
ExecStartPre=/usr/bin/node -v
ExecStartPre=/usr/bin/npm -v
ExecStartPre=/usr/bin/test -f /opt/akalynth/dist/server/apps/server/src/index.js
# Fail fast (not silently) if the chronicle signing key is missing.
ExecStartPre=/usr/bin/test -f /etc/akalynth/chronicle.key
ExecStartPre=/usr/bin/bash -c 'test -f /etc/akalynth/chronicle.key || { echo "FATAL: chronicle key missing at /etc/akalynth/chronicle.key; refusing to start" >&2; exit 1; }'
ExecStartPre=/usr/bin/bash -c 'mkdir -p /var/lib/akalynth/{data,audit} && touch /var/lib/akalynth/audit/receipts.jsonl'

ExecStart=/usr/bin/node /opt/akalynth/dist/server/apps/server/src/index.js

Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20

LimitNOFILE=65536

# Hardening (issue #147). systemd-analyze security: this set scores ~1.4 "OK".
# MemoryDenyWriteExecute stays FALSE: Node's V8 JIT needs writable+executable
# memory and crashes under MDWX=true. The beta lane gets the same set via
# infra/systemd/akalynth-beta.service.d/20-hardening.conf.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/akalynth

# Loopback :3000 is unprivileged -> drop all capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
# TCP (INET/INET6) + AF_UNIX + AF_NETLINK (Node uses netlink for iface/DNS info).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Curated service syscall allowlist minus privileged/resource-control families.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
